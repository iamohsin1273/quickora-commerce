apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - ../../base
images:
  - name: quickora-api
    newName: ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/quickora-eks-api
    digest: REPLACE_WITH_API_DIGEST
  - name: quickora-web
    newName: ACCOUNT_ID.dkr.ecr.ap-south-1.amazonaws.com/quickora-eks-web
    digest: REPLACE_WITH_WEB_DIGEST
